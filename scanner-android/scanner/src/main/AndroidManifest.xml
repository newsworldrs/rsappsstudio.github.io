<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Not required: the host app decides whether it can be installed without a camera. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only for the one-time OCR language model download (RsOcr). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only used on Android 9 and older, and only when saving to public Downloads / Pictures. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <activity
            android:name="com.rskusum.scanner.ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.RsScanner">
            <!-- The scanner screen always keeps its portrait layout; only its icons turn with the
                 phone. Android 16 may ignore the portrait lock for apps targeting API 36 and
                 users can force "full screen" per app: opt this screen out of both. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_USER_ASPECT_RATIO_OVERRIDE"
                android:value="false" />
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_USER_ASPECT_RATIO_FULLSCREEN_OVERRIDE"
                android:value="false" />
        </activity>

        <!-- Own provider class + authority so it never clashes with the host app's FileProvider. -->
        <provider
            android:name="com.rskusum.scanner.RsScannerFileProvider"
            android:authorities="${applicationId}.rsscanner.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rs_scanner_file_paths" />
        </provider>
    </application>
</manifest>
