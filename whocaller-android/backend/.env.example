# Backend configuration (never commit real values; use Secret Manager in production).
# Firebase project to deploy to:
FIREBASE_PROJECT_ID=your-project-id
# Play Developer API service account for subscription verification (store in Secret Manager):
PLAY_SERVICE_ACCOUNT_SECRET=projects/your-project-id/secrets/play-service-account/versions/latest
PLAY_PACKAGE_NAME=com.rskusum.whocaller
