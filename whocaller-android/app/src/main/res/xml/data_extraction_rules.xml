<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Keystore-encrypted values can't be restored on another device, so they're excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="whocaller_secure.xml" />
        <exclude domain="sharedpref" path="whocaller_permissions.xml" />
        <exclude domain="database" path="whocaller.db" />
        <exclude domain="database" path="whocaller.db-shm" />
        <exclude domain="database" path="whocaller.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="whocaller_secure.xml" />
        <exclude domain="sharedpref" path="whocaller_permissions.xml" />
    </device-transfer>
</data-extraction-rules>
