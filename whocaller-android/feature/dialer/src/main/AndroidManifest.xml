<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to act as the default phone app. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Only for the self-view during video calls. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <!-- Phone/SMS features are optional so the app still installs on tablets and Chromebooks. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application>
        <!-- Telecom binds this when WhoCaller is the default phone app. Telecom plays the ringtone. -->
        <service
            android:name=".WhoCallerInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <activity
            android:name=".InCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity="com.rskusum.whocaller.incall"
            android:theme="@style/Theme.WhoCaller.Call"
            android:turnScreenOn="true" />

        <!-- Dialpad. Handling ACTION_DIAL is required for the default phone app role. -->
        <activity
            android:name=".DialerActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/dialer_label"
            android:theme="@style/Theme.WhoCaller.Dialer"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />
    </application>
</manifest>
