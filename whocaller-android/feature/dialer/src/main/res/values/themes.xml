<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WhoCaller.Call" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Keypad/Recents/Contacts: starts on the brand background so there is no black flash. -->
    <style name="Theme.WhoCaller.Dialer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/dialer_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
