<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Android 10+: bound by Telecom once the user grants WhoCaller the call-screening role. -->
        <service
            android:name=".WhoCallerScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Android 8–9 only: identification (not blocking) from the phone-state broadcast. Disabled on 10+. -->
        <receiver
            android:name=".LegacyPhoneStateReceiver"
            android:enabled="@bool/whocaller_legacy_phone_receiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
